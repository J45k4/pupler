generator client {
	provider = "prisma-client"
	output   = "../src/generated/prisma"
}

datasource db {
	provider = "sqlite"
}

model Ingredient {
	id                  Int                @id @default(autoincrement())
	name                String
	default_unit        String?            @map("default_unit")
	created_at          String             @map("created_at")
	updated_at          String             @map("updated_at")
	products            Product[]
	inventory_items     InventoryItem[]
	recipe_ingredients  RecipeIngredient[]
	shopping_list_items ShoppingListItem[]

	@@map("ingredients")
}

model Product {
	id                   Int                @id @default(autoincrement())
	ingredient_id        Int?               @map("ingredient_id")
	name                 String
	category             String
	barcode              String?            @unique
	default_unit         String?            @map("default_unit")
	is_perishable        Boolean            @map("is_perishable")
	picture_file_id      Int?               @map("picture_file_id")
	created_at           String             @map("created_at")
	updated_at           String             @map("updated_at")
	ingredient           Ingredient?        @relation(fields: [ingredient_id], references: [id])
	picture_file         File?              @relation("ProductPicture", fields: [picture_file_id], references: [id], onDelete: SetNull)
	product_links        ProductLink[]
	receipt_items        ReceiptItem[]
	inventory_items      InventoryItem[]
	recipe_ingredients   RecipeIngredient[]
	shopping_list_items  ShoppingListItem[]

	@@index([ingredient_id], map: "idx_products_ingredient_id")
	@@index([picture_file_id], map: "idx_products_picture_file_id")
	@@map("products")
}

model ProductLink {
	id         Int     @id @default(autoincrement())
	product_id Int     @map("product_id")
	label      String
	url        String
	created_at String  @map("created_at")
	product    Product @relation(fields: [product_id], references: [id])

	@@index([product_id], map: "idx_product_links_product_id")
	@@map("product_links")
}

model Group {
	id         Int       @id @default(autoincrement())
	name       String    @unique
	created_at String    @map("created_at")
	updated_at String    @map("updated_at")
	receipts   Receipt[]

	@@map("groups")
}

model Receipt {
	id                   Int           @id @default(autoincrement())
	group_id             Int?          @map("group_id")
	store_name           String        @map("store_name")
	purchased_at         String        @map("purchased_at")
	currency             String
	total_amount         Float?        @map("total_amount")
	picture_file_id      Int?          @map("picture_file_id")
	created_at           String        @map("created_at")
	updated_at           String        @map("updated_at")
	group                Group?        @relation(fields: [group_id], references: [id], onDelete: SetNull)
	picture_file         File?         @relation("ReceiptPicture", fields: [picture_file_id], references: [id], onDelete: SetNull)
	receipt_items        ReceiptItem[]

	@@index([group_id], map: "idx_receipts_group_id")
	@@index([picture_file_id], map: "idx_receipts_picture_file_id")
	@@map("receipts")
}

model ReceiptItem {
	id         Int             @id @default(autoincrement())
	receipt_id Int             @map("receipt_id")
	product_id Int             @map("product_id")
	quantity   Float
	unit       String
	unit_price Float?          @map("unit_price")
	line_total Float?          @map("line_total")
	created_at String          @map("created_at")
	receipt    Receipt         @relation(fields: [receipt_id], references: [id])
	product    Product         @relation(fields: [product_id], references: [id])
	items      InventoryItem[]

	@@index([receipt_id], map: "idx_receipt_items_receipt_id")
	@@index([product_id], map: "idx_receipt_items_product_id")
	@@map("receipt_items")
}

model InventoryContainer {
	id                  Int                  @id @default(autoincrement())
	name                String
	parent_container_id Int?                 @map("parent_container_id")
	notes               String?
	created_at          String               @map("created_at")
	updated_at          String               @map("updated_at")
	parent_container    InventoryContainer?  @relation("InventoryContainerTree", fields: [parent_container_id], references: [id])
	child_containers    InventoryContainer[] @relation("InventoryContainerTree")
	inventory_items     InventoryItem[]

	@@index([parent_container_id], map: "idx_inventory_containers_parent_id")
	@@map("inventory_containers")
}

model InventoryItem {
	id              Int                 @id @default(autoincrement())
	name            String
	ingredient_id   Int?                @map("ingredient_id")
	product_id      Int?                @map("product_id")
	receipt_item_id Int?                @map("receipt_item_id")
	container_id    Int?                @map("container_id")
	quantity        Float
	unit            String
	purchased_at    String?             @map("purchased_at")
	expires_at      String?             @map("expires_at")
	consumed_at     String?             @map("consumed_at")
	notes           String?
	created_at      String              @map("created_at")
	updated_at      String              @map("updated_at")
	ingredient      Ingredient?         @relation(fields: [ingredient_id], references: [id])
	product         Product?            @relation(fields: [product_id], references: [id])
	receipt_item    ReceiptItem?        @relation(fields: [receipt_item_id], references: [id])
	container       InventoryContainer? @relation(fields: [container_id], references: [id])
	inventory_item_images InventoryItemImage[]

	@@index([ingredient_id], map: "idx_inventory_ingredient_id")
	@@index([product_id], map: "idx_inventory_product_id")
	@@index([container_id], map: "idx_inventory_container_id")
	@@map("inventory_items")
}

model InventoryItemImage {
	id                Int           @id @default(autoincrement())
	inventory_item_id Int           @map("inventory_item_id")
	file_id           Int           @map("file_id")
	created_at        String        @map("created_at")
	inventory_item    InventoryItem @relation(fields: [inventory_item_id], references: [id], onDelete: Cascade)
	file              File          @relation(fields: [file_id], references: [id], onDelete: Cascade)

	@@index([inventory_item_id], map: "idx_inventory_item_images_inventory_item_id")
	@@index([file_id], map: "idx_inventory_item_images_file_id")
	@@map("inventory_item_images")
}

model File {
	id                    Int                  @id @default(autoincrement())
	path                  String               @unique
	content_type          String               @map("content_type")
	filename              String?
	size_bytes            Int                  @map("size_bytes")
	created_at            String               @map("created_at")
	product_pictures      Product[]            @relation("ProductPicture")
	receipt_pictures      Receipt[]            @relation("ReceiptPicture")
	inventory_item_images InventoryItemImage[]
	recipe_images         RecipeImage[]

	@@map("files")
}

model Recipe {
	id                  Int                @id @default(autoincrement())
	name                String
	description         String?
	instructions        String?
	servings            Int?
	is_active           Boolean            @map("is_active")
	created_at          String             @map("created_at")
	updated_at          String             @map("updated_at")
	ingredients         RecipeIngredient[]
	meal_plan_items     MealPlanItem[]
	recipe_images       RecipeImage[]
	shopping_list_items ShoppingListItem[]

	@@map("recipes")
}

model RecipeImage {
	id           Int    @id @default(autoincrement())
	recipe_id    Int    @map("recipe_id")
	file_id      Int    @map("file_id")
	created_at   String @map("created_at")
	recipe       Recipe @relation(fields: [recipe_id], references: [id], onDelete: Cascade)
	file         File   @relation(fields: [file_id], references: [id], onDelete: Cascade)

	@@index([recipe_id], map: "idx_recipe_images_recipe_id")
	@@index([file_id], map: "idx_recipe_images_file_id")
	@@map("recipe_images")
}

model RecipeIngredient {
	id           Int         @id @default(autoincrement())
	recipe_id    Int         @map("recipe_id")
	ingredient_id Int?       @map("ingredient_id")
	product_id   Int?        @map("product_id")
	name         String
	quantity     Float
	unit         String
	is_optional  Boolean     @map("is_optional")
	notes        String?
	created_at   String      @map("created_at")
	recipe       Recipe      @relation(fields: [recipe_id], references: [id])
	ingredient   Ingredient? @relation(fields: [ingredient_id], references: [id])
	product      Product?    @relation(fields: [product_id], references: [id])

	@@index([recipe_id], map: "idx_recipe_ingredients_recipe_id")
	@@index([ingredient_id], map: "idx_recipe_ingredients_ingredient_id")
	@@index([product_id], map: "idx_recipe_ingredients_product_id")
	@@map("recipe_ingredients")
}

model MealPlanItem {
	id           Int    @id @default(autoincrement())
	recipe_id    Int    @map("recipe_id")
	planned_date String @map("planned_date")
	meal_type    String @map("meal_type")
	servings     Int
	status       String
	created_at   String @map("created_at")
	updated_at   String @map("updated_at")
	recipe       Recipe @relation(fields: [recipe_id], references: [id])

	@@index([recipe_id], map: "idx_meal_plan_recipe_id")
	@@map("meal_plan_items")
}

model ShoppingListItem {
	id               Int         @id @default(autoincrement())
	name             String
	ingredient_id    Int?        @map("ingredient_id")
	product_id       Int?        @map("product_id")
	quantity         Float
	unit             String
	done             Boolean
	source_recipe_id Int?        @map("source_recipe_id")
	notes            String?
	created_at       String      @map("created_at")
	updated_at       String      @map("updated_at")
	ingredient       Ingredient? @relation(fields: [ingredient_id], references: [id])
	product          Product?    @relation(fields: [product_id], references: [id])
	source_recipe    Recipe?     @relation(fields: [source_recipe_id], references: [id])

	@@index([ingredient_id], map: "idx_shopping_list_items_ingredient_id")
	@@index([product_id], map: "idx_shopping_list_items_product_id")
	@@map("shopping_list_items")
}

model Todo {
	id           Int     @id @default(autoincrement())
	title        String
	notes        String?
	status       Int     @default(1)
	due_at       String? @map("due_at")
	completed_at String? @map("completed_at")
	created_at   String  @map("created_at")
	updated_at   String  @map("updated_at")

	@@index([status], map: "idx_todos_status")
	@@index([due_at], map: "idx_todos_due_at")
	@@map("todos")
}

model User {
	id            Int           @id @default(autoincrement())
	name          String
	username      String?       @unique
	email         String?
	password_hash String?       @map("password_hash")
	is_admin      Boolean       @default(false) @map("is_admin")
	created_at    String        @map("created_at")
	updated_at    String        @map("updated_at")
	time_entries  TimeEntry[]
	sessions      UserSession[]

	@@map("users")
}

model UserSession {
	id             Int    @id @default(autoincrement())
	user_id        Int    @map("user_id")
	token_hash     String @unique @map("token_hash")
	expires_at     String @map("expires_at")
	created_at     String @map("created_at")
	last_seen_at   String? @map("last_seen_at")
	user           User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

	@@index([user_id], map: "idx_user_sessions_user_id")
	@@index([expires_at], map: "idx_user_sessions_expires_at")
	@@map("user_sessions")
}

model Client {
	id          Int       @id @default(autoincrement())
	name        String
	color       String
	archived_at String?   @map("archived_at")
	created_at  String    @map("created_at")
	updated_at  String    @map("updated_at")
	projects    Project[]

	@@index([name], map: "idx_clients_name")
	@@index([archived_at], map: "idx_clients_archived_at")
	@@map("clients")
}

model Project {
	id           Int         @id @default(autoincrement())
	client_id    Int?        @map("client_id")
	name         String
	color        String
	archived_at  String?     @map("archived_at")
	created_at   String      @map("created_at")
	updated_at   String      @map("updated_at")
	client       Client?     @relation(fields: [client_id], references: [id], onDelete: SetNull)
	time_entries TimeEntry[]

	@@index([client_id], map: "idx_projects_client_id")
	@@index([name], map: "idx_projects_name")
	@@index([archived_at], map: "idx_projects_archived_at")
	@@map("projects")
}

model TimeEntry {
	id          Int          @id @default(autoincrement())
	user_id     Int?         @map("user_id")
	project_id  Int?         @map("project_id")
	description String?
	started_at  String       @map("started_at")
	ended_at    String?      @map("ended_at")
	created_at  String       @map("created_at")
	updated_at  String       @map("updated_at")
	user        User?        @relation(fields: [user_id], references: [id], onDelete: SetNull)
	project     Project?     @relation(fields: [project_id], references: [id])

	@@index([user_id], map: "idx_time_entries_user_id")
	@@index([project_id], map: "idx_time_entries_project_id")
	@@index([started_at], map: "idx_time_entries_started_at")
	@@index([ended_at], map: "idx_time_entries_ended_at")
	@@map("time_entries")
}
