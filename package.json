{
	"name": "pupler",
	"private": true,
	"type": "module",
	"scripts": {
		"backup": "bash deploy/backup.sh",
		"build:bins": "bun run build:server-bin && bun run build:cli-bin",
		"build:cli-bin": "bun -e \"import { mkdirSync } from 'node:fs'; mkdirSync('dist', { recursive: true });\" && bun run prisma:generate && bun build --compile --outfile dist/pupler-cli ./cli/cli.ts",
		"build:server-bin": "bun -e \"import { mkdirSync } from 'node:fs'; mkdirSync('dist', { recursive: true });\" && bun run prisma:generate && bun build --compile --outfile dist/pupler-server ./src/main.ts",
		"cli": "bun ./cli/cli.ts",
		"dev": "bun --watch src/main.ts",
		"postinstall": "bun run prisma:generate",
		"prisma:db:push": "bunx --bun prisma db push --schema prisma/schema.prisma",
		"prisma:generate": "bunx --bun prisma generate",
		"prisma:migrate:deploy": "bunx --bun prisma migrate deploy --schema prisma/schema.prisma",
		"prisma:migrate:dev": "bunx --bun prisma migrate dev --schema prisma/schema.prisma",
		"seed": "bun scripts/seed.ts",
		"create-user": "bun scripts/create-user.ts",
		"start": "bun src/main.ts",
		"test": "bun test",
		"test:api": "bun test test/api.test.ts",
		"test:cli": "bun test test/cli.test.ts",
		"test:e2e": "bun test test/e2e.test.ts",
		"build:release": "bun run prisma:generate && bun scripts/build-release.ts"
	},
	"module": "index.ts",
	"devDependencies": {
		"@types/bun": "latest",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"prisma": "^7.7.0"
	},
	"peerDependencies": {
		"typescript": "^5"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.30.0",
		"@prisma/adapter-libsql": "^7.7.0",
		"@prisma/client": "^7.7.0",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"zod": "^4.6.5"
	}
}
